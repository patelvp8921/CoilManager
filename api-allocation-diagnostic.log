        WHERE [w].[Id] = [w0].[WorkOrderId] AND [w0].[Status] IN (N'Reserved', N'Issued', N'PartiallyConsumed')), 0.0) AS [c], (
        SELECT COUNT(*)
        FROM [app].[WorkOrderOperations] AS [w1]
        WHERE [w].[Id] = [w1].[WorkOrderId] AND [w1].[IsRequired] = CAST(1 AS bit)) AS [c0], (
        SELECT COUNT(*)
        FROM [app].[WorkOrderOperations] AS [w2]
        WHERE [w].[Id] = [w2].[WorkOrderId] AND [w2].[IsRequired] = CAST(1 AS bit) AND [w2].[Status] = N'Completed') AS [c1]
    FROM [app].[WorkOrders] AS [w]
    ORDER BY [w].[CreatedAtUtc] DESC
    OFFSET @__p_0 ROWS FETCH NEXT @__p_1 ROWS ONLY
) AS [t]
LEFT JOIN (
    SELECT [t1].[Id], [t1].[LaminationJobNumber], [t1].[Status], [t1].[TotalWeight], [t1].[TotalAllocatedWeight], [t1].[c], [t1].[WorkOrderId]
    FROM (
        SELECT [l].[Id], [l].[LaminationJobNumber], [l].[Status], [l].[TotalWeight], [l].[TotalAllocatedWeight], 1 AS [c], [l].[WorkOrderId], ROW_NUMBER() OVER(PARTITION BY [l].[WorkOrderId] ORDER BY [l].[Id]) AS [row]
        FROM [app].[LaminationJobs] AS [l]
        WHERE [l].[IsDeleted] = CAST(0 AS bit)
    ) AS [t1]
    WHERE [t1].[row] <= 1
) AS [t0] ON [t].[Id] = [t0].[WorkOrderId]
ORDER BY [t].[CreatedAtUtc] DESC
