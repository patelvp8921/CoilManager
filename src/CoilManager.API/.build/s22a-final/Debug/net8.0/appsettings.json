{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CoilManager;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "SlittingSettings": {
    "WeightToleranceKg": 0.5,
    "WidthToleranceMm": 0.5,
    "MinimumBalanceWidthMm": 10,
    "DefaultLabelVersion": "1"
  },
  "LabelSettings": {
    "WidthMm": 100,
    "HeightMm": 75,
    "DefaultCopies": 1,
    "DefaultLabelVersion": "1",
    "CompanyName": "Arkon Electricals Private Limited",
    "CompanyAddress": null,
    "CompanyLogoUrl": null,
    "ShowQrCode": true,
    "ShowBarcode": true,
    "BarcodeFormat": "Code128",
    "QrCodeErrorCorrectionLevel": "M",
    "PrintOrientation": "Landscape",
    "PrinterDpi": null
  },
  "JwtSettings": {
    "Issuer": "CoilManager",
    "Audience": "CoilManager.Angular",
    "SecretKey": "CHANGE_ME_TO_A_SECURE_256_BIT_SECRET_FOR_PRODUCTION",
    "ExpiryMinutes": 15,
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Security": {
    "OtpExpiryMinutes": 5,
    "OtpMaximumAttempts": 5,
    "OtpResendSeconds": 60,
    "MaximumFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "OtpHashKey": "CHANGE_ME_USING_USER_SECRETS_OR_ENVIRONMENT"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Properties": {
      "Application": "CoilManager.API"
    }
  }
}
